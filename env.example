# Copy this file to `.env` and edit the values for your environment.

SECRET_KEY=replace_me_with_a_strong_random_key

# Database configuration
# Use a PostgreSQL URI for production, e.g. postgresql+psycopg2://user:password@hostname:port/dbname
DATABASE_URL=sqlite:///gpushare.db

# Mail server configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app-specific-password
MAIL_DEFAULT_SENDER="GPUShare <no-reply@example.com>"

# Base URL of your deployment (used for generating absolute URLs in emails)
BASE_URL=http://localhost:5000

# Cloud storage configuration
# Nextcloud WebDAV endpoint
NEXTCLOUD_URL=https://your-nextcloud.example.com/remote.php/dav/files/username/
NEXTCLOUD_USERNAME=username
NEXTCLOUD_PASSWORD=cloud-password

# Storage provider selection (local, nextcloud, gcs, s3, r2)
# Set STORAGE_PROVIDER to choose where uploaded files are stored.  For
# GCS and S3 providers you must also set STORAGE_BUCKET.  For S3 you
# need AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY; for R2 you may
# additionally set AWS_ENDPOINT_URL.
STORAGE_PROVIDER=local
STORAGE_BUCKET=my-gpushare-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# GCS_CREDENTIALS_JSON=/path/to/service-account.json